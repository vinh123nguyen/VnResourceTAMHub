<Window x:Class="TAMHubApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TAMHubApp"
        xmlns:converter="clr-namespace:TAMHubApp.Converters"
        xmlns:uc="clr-namespace:TAMHubApp.Views.UserControls"
        mc:Ignorable="d"    
        Title="VnResource TAM Hub" Height="540" Width="960"
        Closing="Window_Closing">
    <Window.Icon>
        <BitmapImage UriSource="/Resources/Images/windowicon.png"/>
    </Window.Icon>
    <Window.Resources>
        <converter:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" x:Name="navBar" Style="{StaticResource style_navBar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <Button Style="{StaticResource style_navButton}" Template="{StaticResource NoMouseOverButtonTemplate}" Background="White" Command="{Binding NavigateHomeCommand}" Grid.Column="0">
                        <Image Source="/Resources/Images/logovnr.png" Margin="8,8,8,8"/>
                    </Button>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Width="auto">

                        <Button x:Name="NavButton" Style="{StaticResource style_navButton}" 
                                Template="{StaticResource NoMouseOverButtonTemplate}" Background="White" Grid.Column="0"
                                MouseEnter="NavButton_MouseEnter" MouseLeave="NavButton_MouseLeave">
                            <Border Background="#E6F7FF" Padding="12,8" BorderThickness="0,0,2,0" BorderBrush="#329DFF" Width="200">
                                <Grid >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource Icon_Setting1}" Stroke="#1890FF" StrokeThickness="1" Height="16" Width="16" Stretch="Fill"/>
                                    <Path Grid.Column="0" Data="{StaticResource Icon_Setting2}" Stroke="#1890FF" StrokeThickness="1" Height="8" Width="8" Stretch="Fill"/>
                                    <TextBlock Foreground="#1890FF" Margin="4" Grid.Column="1" Text="Tải dữ liệu chấm công"/>
                                </Grid>
                            </Border>
                        </Button>

                        <Popup x:Name="NavPopup" PlacementTarget="{Binding ElementName=NavButton}" Placement="Bottom" StaysOpen="False">
                            <Border Background="White" BorderBrush="Gray" BorderThickness="0">
                                <StackPanel>
                                    <uc:NavigationButtonUC
                                        Icon="{DynamicResource Icon_Device}"
                                        Title="{DynamicResource LANG_NAV_Device}"
                                        NavigateCommand="{Binding NavigateDeviceCommand}"
                                        TabActive="{Binding TabActive}"
                                        NameTab="DeviceView"
                                        />
                                    <uc:NavigationButtonUC
                                        Icon="{DynamicResource Icon_Calendar}"
                                        Title="{DynamicResource LANG_NAV_Schedule}"
                                        NavigateCommand="{Binding NavigateScheduleCommand}"
                                        TabActive="{Binding TabActive}"
                                        NameTab="ScheduleView"
                                        />
                                    <uc:NavigationButtonUC
                                        Icon="{DynamicResource Icon_Reload}"
                                        Title="{DynamicResource LANG_NAV_ActionLog}"
                                        NavigateCommand="{Binding NavigateActionLogCommand}"
                                        TabActive="{Binding TabActive}"
                                        NameTab="ActionLogView" />
                                    <uc:NavigationButtonUC
                                        Icon="{DynamicResource Icon_Data}"
                                        Title="{DynamicResource LANG_NAV_Data}"
                                        NavigateCommand="{Binding NavigateDataCommand}"
                                        TabActive="{Binding TabActive}"
                                        NameTab="DataView"
                                        />
                                    <uc:NavigationButtonUC
                                        Icon="{DynamicResource Icon_Setting}"
                                        Title="{DynamicResource LANG_NAV_Setting}"
                                        NavigateCommand="{Binding NavigateSettingCommand}"
                                        TabActive="{Binding TabActive}"
                                        NameTab="SettingView"
                                        />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                </Grid>
            </Border>
            <ContentControl Grid.Row="1" Content="{Binding MainViewNavigate.CurrentView}">
            </ContentControl>
        </Grid>

        <!--<Grid Background="#100000FF" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <uc:LoadingUC/>
        </Grid>
        <uc:ToastNotificationUC x:Name="ToastNotification" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" 
                                Message="{Binding ToastMessage}"
                                IsShowingToast="{Binding IsShowingToast}"
                                ToastColor ="{Binding ToastColor}"/>-->
    </Grid>
</Window>
