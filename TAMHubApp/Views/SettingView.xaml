<UserControl x:Class="TAMHubApp.Views.SettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TAMHubApp.Views"
             xmlns:uc="clr-namespace:TAMHubApp.Views.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#EFF3FF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <StackPanel Background="White">
            <uc:NavigationButtonUC
                Background="White"
                Icon="{DynamicResource Icon_Home}"
                Title="{DynamicResource LANG_SET_General}"
                NavigateCommand="{Binding NavigateGeneralCommand}"
                TabActive="{Binding TabActive}"
                NameTab="General"
                />
            <uc:NavigationButtonUC
                Background="White"
                Icon="{DynamicResource Icon_Device}"
                Title="{DynamicResource LANG_SET_ZKTeco}"
                NavigateCommand="{Binding NavigateZKTecoCommand}"
                TabActive="{Binding TabActive}"
                NameTab="ZKTeco"
                />
            <uc:NavigationButtonUC
                Background="White"
                Icon="{DynamicResource Icon_Device}"
                Title="{DynamicResource LANG_SET_Realand}"
                NavigateCommand="{Binding NavigateRealandCommand}"
                TabActive="{Binding TabActive}"
                NameTab="Realand"
                />
        </StackPanel>

        <ContentControl Grid.Column="1" Content="{Binding SettingNavigate.CurrentView}">
        </ContentControl>

    </Grid>
</UserControl>
