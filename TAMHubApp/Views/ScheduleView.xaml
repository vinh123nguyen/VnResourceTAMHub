<UserControl x:Class="TAMHubApp.Views.ScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TAMHubApp.Views"
             xmlns:uc="clr-namespace:TAMHubApp.Views.UserControls"
            xmlns:converter="clr-namespace:TAMHubApp.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <converter:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Background="#EFF3FF">
        <Grid Grid.ColumnSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <uc:ButtonUC 
                    Title="{StaticResource LANG_SCH_AddSchedule}"
                    Icon="{StaticResource Icon_Plus}"
                    ClickCommand="{Binding OpenInfoPopupCommand}"
                    ButtonBackground="#B5C9FF"
                    IconBackground="#0066FF"
                    TextFontSize="16"
                    Margin="8,0"
                    />

                <uc:ButtonUC Grid.Column="1"
                    Title="{StaticResource LANG_SCH_RunAllSchedule}"
                    Icon="{StaticResource Icon_Link}"
                    ClickCommand="{Binding StartAllCommand}"
                    ButtonBackground="#B6FFB5"
                    IconBackground="#1BBB48"
                    TextFontSize="16"
                    Margin="8,0"
                    />

                <uc:ButtonUC Grid.Column="2"
                     Title="{StaticResource LANG_SCH_StopAllSchedule}"
                     Icon="{StaticResource Icon_Power}"
                     ClickCommand="{Binding StopAllCommand}"
                     ButtonBackground="#FFB5B9"
                     IconBackground="#FF3C3C"
                     TextFontSize="16"
                     Margin="8,0"
                     />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ScheduleTasks}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <uc:ScheduleCardItemUC 
                                OpenEditPopupCommand="{Binding DataContext.OpenInfoPopupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                TongleOnOffCommand="{Binding DataContext.TongleOnOffCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>


        </Grid>

        <Grid x:Name="SchedulePageOverlay" Background="#50CECECE"
            Visibility="{Binding IsOverlayPopupOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ContentControl VerticalAlignment="Center" HorizontalAlignment="Center" 
                    Width="400"
                    Height="Auto"
                    Content="{Binding OverlayNavigate.CurrentView}">
            </ContentControl>
        </Grid>
    </Grid>
</UserControl>
