<UserControl x:Class="TAMHubApp.Views.UserControls.DeviceCardItemUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TAMHubApp.Views.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="300">
    <UserControl.Resources>
        <Style x:Key="style_DeviceCardItemGrid" TargetType="Grid">
            <Setter Property="Margin" Value="8"/>

        </Style>

        <Style x:Key="style_DeviceCardItem" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>

        </Style>


    </UserControl.Resources>
    <Border Style="{StaticResource style_DeviceCardItem}">
        <Grid Style="{StaticResource style_DeviceCardItemGrid}">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Path Margin="8" Data="{StaticResource Icon_Device}" Stroke="Black" StrokeThickness="0.7" Height="16" Width="16" Stretch="Fill" />
                    <TextBlock FontWeight="Bold" VerticalAlignment="Center" Text="Máy chấm công 1"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>


            </Grid>

        </Grid>
    </Border>
</UserControl>
