<UserControl x:Class="TAMHubApp.Views.UserControls.GeneralSettingViewUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TAMHubApp.Views.UserControls"
             mc:Ignorable="d" 
             xmlns:uc="clr-namespace:TAMHubApp.Views.UserControls"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <uc:ButtonUC HorizontalAlignment="Left" Width="Auto" 
            Grid.Column="0" Grid.Row="0" Margin="4"
            FontSize="10" Title="{StaticResource LANG_GLO_Save}" 
            Icon="{StaticResource Icon_Download}" 
            IconBackground="#1BBB48" 
            ButtonBackground="#B6FFB5" Padding="1"
            ClickCommand="{Binding SaveConfigCommand}"/>


        <StackPanel Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal">
            <TextBlock FontSize="16" Margin="4" Text="{StaticResource LANG_SET_MinScheduleDateStart}"/>
            <DatePicker Grid.Column="2" Height="26" Width="200"
                Margin="4" Background="White" 
                SelectedDate="{Binding MinScheduleDateStart}"/>
        </StackPanel>

        <RadioButton IsChecked="{Binding IsSyncDb}" GroupName="SyncType" Grid.Row="2" Margin="4" Content="Đồng bộ qua DB"/>
        <RadioButton IsChecked="{Binding IsSyncApi}" GroupName="SyncType" Grid.Row="2" Margin="4" Grid.Column="1" Content="Đồng bộ qua API"/>

        <Grid Grid.Row="3" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock FontSize="16" Margin="4" Grid.Row="0" Grid.Column="1" Text="{StaticResource LANG_SET_Server}"/>
            <TextBlock FontSize="16" Margin="4" Grid.Row="1" Grid.Column="1" Text="{StaticResource LANG_SET_DBName}"/>
            <TextBlock FontSize="16" Margin="4" Grid.Row="2" Grid.Column="1" Text="{StaticResource LANG_SET_UserID}"/>
            <TextBlock FontSize="16" Margin="4" Grid.Row="3" Grid.Column="1" Text="{StaticResource LANG_SET_Pwd}"/>

            <TextBox Text="{Binding ServerName}" Margin="4" Width="200" Grid.Row="0" Grid.Column="2" />
            <TextBox Text="{Binding DbName}" Margin="4" Grid.Row="1" Grid.Column="2" />
            <TextBox Text="{Binding UserId}" Margin="4" Grid.Row="2" Grid.Column="2" />
            <TextBox Text="{Binding Password}" Margin="4" Grid.Row="3" Grid.Column="2" />

        </Grid>

        <Grid Grid.Row="3" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                <TextBlock FontSize="16" Margin="4"  Text="{StaticResource LANG_SET_API}"/>
                <TextBox Text="{Binding ApiAddress}" Margin="4" Width="280" />
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                <TextBlock FontSize="16" Margin="4" Text="{StaticResource LANG_SET_MaxRowNumPerRequest}"/>
                <TextBox Text="{Binding MaxRowNumPerRequest}" Margin="4" Width="50" />
            </StackPanel>


        </Grid>
    
    </Grid>
</UserControl>
