<UserControl x:Class="TAMHubApp.Views.UserControls.Nav_NavigationButtonUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TAMHubApp.Views.UserControls"
             mc:Ignorable="d" 
             Name="navButtonUC"
             d:DesignHeight="48" d:DesignWidth="100">

    <Button Template="{StaticResource NoMouseOverButtonTemplate}" Style="{StaticResource style_navButton}" x:Name="navButton" Command="{Binding ElementName=navButtonUC,Path=NavigateCommand}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="7"></RowDefinition>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0"  Orientation="Horizontal">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{Binding ElementName=navButtonUC,Path=Icon}" Stroke="Black" StrokeThickness="0.7" Height="16" Width="16" Stretch="Fill" />
                    <TextBlock Text="{Binding ElementName=navButtonUC,Path=Title}" FontSize="14" Padding="5,0"></TextBlock>
                </StackPanel>
            </StackPanel>
            <Border Grid.Row="1" Style="{StaticResource style_navButtonLine}" Visibility="Hidden"></Border>
        </Grid>
    </Button>
</UserControl>
