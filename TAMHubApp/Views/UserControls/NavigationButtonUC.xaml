<UserControl x:Class="TAMHubApp.Views.UserControls.NavigationButtonUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TAMHubApp.Views.UserControls"
             xmlns:converter="clr-namespace:TAMHubApp.Converters"
             mc:Ignorable="d" 
             Name="navButtonUC"
             d:DesignHeight="48" d:DesignWidth="200">
    <UserControl.Resources>
        <converter:StringTabNameToVisibilityConverter x:Key="StringTabNameToVisibilityConverter" />

        <Style x:Key="style_navButton" TargetType="Button">

            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#000" />
            <Setter Property="Tag" Value="Hidden" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />


            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E6F7FF" />
                    <Setter Property="Foreground" Value="#329DFF" />
                </Trigger>

                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Tag" Value="Hidden" />
                </Trigger>

                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E6F7FF" />
                    <Setter Property="Foreground" Value="#329DFF" />
                </Trigger>

            </Style.Triggers>
        </Style>
        <Style x:Key="BorderStyle" TargetType="Border">
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Value="False">
                    <Setter Property="BorderThickness" Value="0,0,2,0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Button Template="{StaticResource NoMouseOverButtonTemplate}" Style="{StaticResource style_navButton}" x:Name="navButton" Command="{Binding ElementName=navButtonUC,Path=NavigateCommand}">
        <Border Style="{StaticResource BorderStyle}" BorderBrush="#329DFF" Width="200">
            
            <Grid Margin="14,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="{Binding ElementName=navButtonUC,Path=Title}" FontSize="12" Padding="5,0"></TextBlock>
            </Grid>
        </Border>
    </Button>
</UserControl>
