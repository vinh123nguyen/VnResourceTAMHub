<UserControl x:Class="TAMHubApp.Views.UserControls.ConnectingLoading"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TAMHubApp.Views.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="20" d:DesignWidth="20">
    <Canvas Background="Green" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">

        <Ellipse Grid.Column="0" x:Name="EllipseName" Width="10" Height="010" Fill="#3498db " HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse.RenderTransform>
                <TransformGroup>
                    <RotateTransform x:Name="RotateTransformname"/>
                </TransformGroup>
            </Ellipse.RenderTransform>
        </Ellipse>

        <Canvas.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimation Storyboard.TargetName="RotateTransformname"
                            Storyboard.TargetProperty="Angle"
                            From="0" To="360"
                            Duration="0:0:2" />
                        
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Canvas.Triggers>


    </Canvas>
</UserControl>
