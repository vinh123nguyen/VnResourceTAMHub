<UserControl x:Class="TAMHubApp.Views.UserControls.SelectDateRangeGetDataUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:uc="clr-namespace:TAMHubApp.Views.UserControls"
             xmlns:local="clr-namespace:TAMHubApp.Views.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="400">
    <UserControl.Resources>
        <Style x:Key="style_masterBoder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
        <Style x:Key="style_HeaderBoder" TargetType="Border">
            <Setter Property="BorderThickness" Value="0,0,0,0.5"/>
            <Setter Property="BorderBrush" Value="#949494"/>
        </Style>
        <Style x:Key="style_CloseButton" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Resources>
    <Border Style="{StaticResource style_masterBoder}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource style_HeaderBoder}">
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Margin="8" FontSize="14" FontWeight="DemiBold" Grid.Row="0" Text="{StaticResource LANG_DEV_DownloadData}"/>
                    <Button Grid.Column="1" Margin="8" Style="{StaticResource style_CloseButton}" Command="{Binding CloseOverlayCommand}">
                        <Border CornerRadius="8">
                            <Path Data="{DynamicResource Icon_Close}" Stroke="Black" StrokeThickness="1" Height="14" Width="14" Stretch="Fill"/>
                        </Border>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock  Grid.Column="1" Grid.Row="0" Text="{StaticResource LANG_DEV_FromDate}" Margin="8,8,8,8" />
                <DatePicker Grid.Column="2" Grid.Row="0" Height="26" Width="200"
                    Margin="4" Background="White" 
                    SelectedDate="{Binding DateFrom}"/>

                <TextBlock  Grid.Column="1" Grid.Row="1" Text="{StaticResource LANG_DEV_ToDate}" Margin="8,8,8,8" />
                <DatePicker Grid.Column="2" Grid.Row="1" Height="26" Width="200"
                    Margin="4" Background="White" 
                    SelectedDate="{Binding DateTo}"/> 
            </Grid>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <uc:ButtonUC
                    Grid.Column="1"
                    IconBackground="#1BBB48" 
                    ButtonBackground="#B6FFB5" Padding="8"
                    Icon="{StaticResource Icon_Download}" 
                    ClickCommand="{Binding DownloadDataByDateCommand}"
                    Title="{StaticResource LANG_DEV_DownByDate}"/>
                <uc:ButtonUC
                    Grid.Column="2"
                    IconBackground="#1BBB48" 
                    ButtonBackground="#B6FFB5" Padding="8"
                    Icon="{StaticResource Icon_Download}" 
                    ClickCommand="{Binding DownloadAllDateCommand}"
                    Title="{StaticResource LANG_DEV_DownAll}"/>
            </Grid>


        </Grid>
    </Border>
</UserControl>
