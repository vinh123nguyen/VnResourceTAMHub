<UserControl x:Class="TAMHubApp.Views.UserControls.SelectDateRangeGetDataUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:uc="clr-namespace:TAMHubApp.Views.UserControls"
             xmlns:local="clr-namespace:TAMHubApp.Views.UserControls"
             xmlns:sdl="http://schemas.sdl.com/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="400">
    <UserControl.Resources>
        <Style x:Key="style_masterBoder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
        <Style x:Key="style_HeaderBoder" TargetType="Border">
            <Setter Property="BorderThickness" Value="0,0,0,0.5"/>
            <Setter Property="BorderBrush" Value="#949494"/>
        </Style>
        <Style x:Key="style_CloseButton" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <DataTemplate x:Key="MultiSelectComboBox.Dropdown.ListBox.ItemTemplate" DataType="models:LanguageItem">
            <TextBlock Grid.Column="1" Text="{Binding Path=Name}"/>
        </DataTemplate>
        <Style x:Key="style_RequiredMark" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Red"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Text" Value="*"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </UserControl.Resources>
    <Border Style="{StaticResource style_masterBoder}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource style_HeaderBoder}">
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Margin="8" FontSize="14" FontWeight="DemiBold" Grid.Row="0" Text="{DynamicResource LANG_DEV_DownloadData}"/>
                    <Button Grid.Column="1" Margin="8" Style="{StaticResource style_CloseButton}" Command="{Binding CloseOverlayCommand}">
                        <Border CornerRadius="8">
                            <Path Data="{DynamicResource Icon_Close}" Stroke="Black" StrokeThickness="1" Height="14" Width="14" Stretch="Fill"/>
                        </Border>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal">
                    <TextBlock Grid.Column="1" Grid.Row="0" Text="{DynamicResource LANG_DEV_Device}" Margin="8,8,0,8" />
                    <TextBlock Style="{StaticResource style_RequiredMark}"/>
                </StackPanel>
                <sdl:MultiSelectComboBox
                    VerticalAlignment="Center"
                    SelectedItemTemplate="{StaticResource MultiSelectComboBox.Dropdown.ListBox.ItemTemplate}"
                    DropdownItemTemplate="{StaticResource MultiSelectComboBox.Dropdown.ListBox.ItemTemplate}"           
                    Margin="4" Height="Auto"
                    Grid.Column="2" Grid.Row="0"
                    SelectionMode="Multiple"
                    ItemsSource="{Binding Items}" 
                    SelectedItems="{Binding SelectedItems}"
                    EnableFiltering="False"
                    MaxDropDownHeight="300"
                    EnableAutoComplete="False"
                    />

                <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal">
                    <TextBlock Grid.Column="1" Grid.Row="1" Text="{DynamicResource LANG_DEV_FromDate}" Margin="8,8,0,8" />
                    <TextBlock Style="{StaticResource style_RequiredMark}"/>
                </StackPanel>
                <DatePicker Grid.Column="2" Grid.Row="1" Height="26" Width="200"
                    Margin="4" Background="White" 
                    SelectedDate="{Binding DateFrom}"/>

                <StackPanel Grid.Column="1" Grid.Row="2" Orientation="Horizontal">
                    <TextBlock Grid.Column="1" Grid.Row="2" Text="{DynamicResource LANG_DEV_ToDate}" Margin="8,8,0,8" />
                    <TextBlock Style="{StaticResource style_RequiredMark}"/>
                </StackPanel>
                <DatePicker Grid.Column="2" Grid.Row="2" Height="26" Width="200"
                    Margin="4" Background="White" 
                    SelectedDate="{Binding DateTo}"/>

                <StackPanel Grid.Column="1" Grid.Row="3" Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource LANG_DEV_EnrollNumber}" Margin="8,8,0,8" />
                </StackPanel>
                <TextBox Grid.Column="2" Grid.Row="3"
                    Width="200" Height="25"
                    Text="{Binding EnrollNumber}"/>


            </Grid>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <uc:ButtonUC
                    Grid.Column="0"
                    IconBackground="#1BBB48" 
                    ButtonBackground="#B6FFB5" Padding="8"
                    Icon="{StaticResource Icon_Download}" 
                    ClickCommand="{Binding OnlyPushDataCommand}"
                    Title="{DynamicResource LANG_DEV_OnlyPushData}"/>
                
                <uc:ButtonUC
                    Grid.Column="2"
                    IconBackground="#1BBB48" 
                    ButtonBackground="#B6FFB5" Padding="8"
                    Icon="{StaticResource Icon_Download}" 
                    ClickCommand="{Binding DownloadDataCommand}"
                    Title="{DynamicResource LANG_DEV_DownloadData}"/>
            </Grid>


        </Grid>
    </Border>
</UserControl>
