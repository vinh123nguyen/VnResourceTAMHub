<UserControl x:Class="TAMHubApp.Views.UserControls.LoadingUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TAMHubApp.Views.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="20" d:DesignWidth="140">
    <Canvas Width="140" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid Width="140" Height="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Ellipse Grid.Column="0" x:Name="EllipseName" Width="0" Height="0" Fill="#3498db " HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="scaleTransform" />
                        <RotateTransform x:Name="rotateTransform" />
                    </TransformGroup>
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Grid.Column="1" x:Name="EllipseName2" Width="0" Height="0" Fill="#e74c3c " HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="scaleTransform2" />
                        <RotateTransform x:Name="rotateTransform2" />
                    </TransformGroup>
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Grid.Column="2" x:Name="EllipseName3" Width="0" Height="0" Fill="#2ecc71 " HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="scaleTransform3" />
                        <RotateTransform x:Name="rotateTransform3" />
                    </TransformGroup>
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Grid.Column="3" x:Name="EllipseName4" Width="0" Height="0" Fill="#f1c40f " HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="scaleTransform4" />
                        <RotateTransform x:Name="rotateTransform4" />
                    </TransformGroup>
                </Ellipse.RenderTransform>
            </Ellipse>
        </Grid>
        <Canvas.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimation Storyboard.TargetName="EllipseName"
                        Storyboard.TargetProperty="Width"
                        From="0" To="20"
                        AutoReverse="True"
                        Duration="0:0:0.6" />

                        <DoubleAnimation Storyboard.TargetName="EllipseName"
                        Storyboard.TargetProperty="Height"
                        From="0" To="20"
                        AutoReverse="True"
                        Duration="0:0:0.6" />
                        <DoubleAnimation Storyboard.TargetName="EllipseName2"
                        Storyboard.TargetProperty="Width"
                        From="0" To="20"
                        AutoReverse="True"
                        BeginTime="0:0:0.3"
                        Duration="0:0:0.6" />
                        <DoubleAnimation Storyboard.TargetName="EllipseName2"
                        Storyboard.TargetProperty="Height"
                        From="0" To="20"
                        AutoReverse="True"
                        BeginTime="0:0:0.3"
                        Duration="0:0:0.6" />
                        <DoubleAnimation Storyboard.TargetName="EllipseName3"
                        Storyboard.TargetProperty="Width"
                        From="0" To="20"
                        AutoReverse="True"
                        BeginTime="0:0:0.6"
                        Duration="0:0:0.6" />
                        <DoubleAnimation Storyboard.TargetName="EllipseName3"
                        Storyboard.TargetProperty="Height"
                        From="0" To="20"
                        AutoReverse="True"
                        BeginTime="0:0:0.6"
                        Duration="0:0:0.6" />
                        <DoubleAnimation Storyboard.TargetName="EllipseName4"
                        Storyboard.TargetProperty="Width"
                        From="0" To="20"
                        AutoReverse="True"
                        BeginTime="0:0:0.9"
                        Duration="0:0:0.6" />
                        <DoubleAnimation Storyboard.TargetName="EllipseName4"
                        Storyboard.TargetProperty="Height"
                        From="0" To="20"
                        AutoReverse="True"
                        BeginTime="0:0:0.9"   
                        Duration="0:0:0.6" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Canvas.Triggers>
    </Canvas>
</UserControl>
