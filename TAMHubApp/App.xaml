<Application x:Class="TAMHubApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModel="clr-namespace:TAMHubApp.ViewModels"
             xmlns:view="clr-namespace:TAMHubApp.Views"
             >
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/MainResource.xaml"/>

            </ResourceDictionary.MergedDictionaries>
            <viewModel:MainViewModel x:Key="MainVM1"></viewModel:MainViewModel>
            <DataTemplate DataType="{x:Type TypeName=viewModel:HomeViewModel}">
                <view:HomeView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type TypeName=viewModel:DeviceViewModel}">
                <view:DeviceView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
