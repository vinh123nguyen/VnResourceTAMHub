<Application x:Class="TAMHubApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModel="clr-namespace:TAMHubApp.ViewModels"
             xmlns:view="clr-namespace:TAMHubApp.Views"
             xmlns:deviceUCVM="clr-namespace:TAMHubApp.ViewModels.UserControls"
             xmlns:viewUC="clr-namespace:TAMHubApp.Views.UserControls"
             >
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/MainResource.xaml"/>

            </ResourceDictionary.MergedDictionaries>
            <DataTemplate DataType="{x:Type TypeName=viewModel:HomeViewModel}">
                <view:HomeView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type TypeName=viewModel:DeviceViewModel}">
                <view:DeviceView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type TypeName=viewModel:DataViewModel}">
                <view:DataView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type TypeName=viewModel:ScheduleViewModel}">
                <view:ScheduleView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type TypeName=viewModel:SettingViewModel}">
                <view:SettingView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type TypeName=deviceUCVM:DeviceItemInfoUCViewModel}">
                <viewUC:DeviceItemInfoUC/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type TypeName=deviceUCVM:SelectDateRangeGetDataUCViewModel}">
                <viewUC:SelectDateRangeGetDataUC/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type TypeName=deviceUCVM:ScheduleTaskItemInfoUCViewModel}">
                <viewUC:ScheduleTaskItemInfoUC/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
